# LLM Report Generation Configuration
LLM_API_KEY=your_groq_or_openai_api_key_here
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT=120
LLM_MAX_OUTPUT_TOKENS=3000
REPORT_PROMPT_VERSION=1.0

# Database & Cache (defaults for local dev)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/nts_db
REDIS_URL=redis://localhost:6379/0

# Storage
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=nts-media
