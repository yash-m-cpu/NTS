# ==============================================================================
# Git Ignore for Unified NTS & CCTV Meeting Intelligence & Workplace Platform
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
logs/
worker.log
*.egg-info/
.eggs/
dist/
build/

# --- Node.js & Web Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store
.vite/
dist-ssr/
*.local

# --- Databases & SQLite Telemetry ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
wbpis_telemetry.db*

# --- Video Media & CCTV Pipeline Outputs ---
Productivity-Analysis-main/output_frames/*
!Productivity-Analysis-main/output_frames/.gitkeep
Productivity-Analysis-main/exports/*
!Productivity-Analysis-main/exports/.gitkeep
Productivity-Analysis-main/logs/*
!Productivity-Analysis-main/logs/.gitkeep
Productivity-Analysis-main/uploads/*.mp4
!Productivity-Analysis-main/uploads/office_sample.mp4

