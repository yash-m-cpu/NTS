# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nts_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_ACCESS_SECRET=replace_this_with_a_secure_secret_in_production
JWT_REFRESH_PEPPER=replace_this_with_a_secure_pepper_in_production

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Storage (MinIO for dev)
STORAGE_ENDPOINT=http://localhost:9000
